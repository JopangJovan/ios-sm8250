+/*
+ * UMI fallback: bit-bang I2C on the TLMM pads.  The ABL leaves SE13's
+ * firmware in GSI mode, where the DFE block (0x2000/0x2008) cannot be
+ * accessed, so the QUP FIFO interface cannot be enabled.  The touch IC is
+ * a plain I2C slave, so drive SDA/SCL as GPIOs instead.
+ */
+static uint64_t touch_bb_freq;
+
+static void
+touch_bb_delay(void)
+{
+	uint64_t start, now, ticks;
+
+	__asm__ volatile("mrs %0, cntvct_el0" : "=r"(start));
+	ticks = (5u * touch_bb_freq) / 1000000u; /* 5 us half period */
+	do {
+		__asm__ volatile("mrs %0, cntvct_el0" : "=r"(now));
+	} while (now - start < ticks);
+}
+
+static void
+touch_bb_sda(bool low)
+{
+	touch_gpio(TOUCH_GPIO_SDA, 0, 3, 2, low, false);
+}
+
+static void
+touch_bb_scl(bool low)
+{
+	touch_gpio(TOUCH_GPIO_SCL, 0, 3, 2, low, false);
+}
+
+static bool
+touch_bb_sda_read(void)
+{
+	return (touch_rd(st.gpio, TOUCH_GPIO_IO(TOUCH_GPIO_SDA)) & 1u) != 0;
+}
+
+static void
+touch_bb_start(void)
+{
+	touch_bb_sda(false);
+	touch_bb_scl(false);
+	touch_bb_delay();
+	touch_bb_sda(true);
+	touch_bb_delay();
+	touch_bb_scl(true);
+	touch_bb_delay();
+}
+
+static void
+touch_bb_stop(void)
+{
+	touch_bb_sda(true);
+	touch_bb_delay();
+	touch_bb_scl(false);
+	touch_bb_delay();
+	touch_bb_sda(false);
+	touch_bb_delay();
+}
+
+static void
+touch_bb_write_bit(bool one)
+{
+	touch_bb_sda(!one);
+	touch_bb_delay();
+	touch_bb_scl(false);
+	touch_bb_delay();
+	touch_bb_scl(true);
+	touch_bb_delay();
+}
+
+static bool
+touch_bb_write_byte(uint8_t b)
+{
+	bool ack;
+
+	for (int i = 7; i >= 0; --i) {
+		touch_bb_write_bit((b >> i) & 1u);
+	}
+	touch_bb_sda(false);
+	touch_bb_delay();
+	touch_bb_scl(false);
+	touch_bb_delay();
+	ack = !touch_bb_sda_read();
+	touch_bb_scl(true);
+	touch_bb_delay();
+	return ack;
+}
+
+static uint8_t
+touch_bb_read_byte(bool ack)
+{
+	uint8_t v = 0;
+
+	for (unsigned i = 0; i < 8; ++i) {
+		touch_bb_sda(false);
+		touch_bb_delay();
+		touch_bb_scl(false);
+		touch_bb_delay();
+		v = (uint8_t)((v << 1) | (touch_bb_sda_read() ? 1u : 0u));
+		touch_bb_scl(true);
+		touch_bb_delay();
+	}
+	touch_bb_sda(!ack);
+	touch_bb_delay();
+	touch_bb_scl(false);
+	touch_bb_delay();
+	touch_bb_scl(true);
+	touch_bb_delay();
+	touch_bb_sda(false);
+	return v;
+}
+
+static int
+touch_bb_msg(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx,
+    unsigned nr, bool stretch)
+{
+	int err = 0;
+
+	touch_bb_start();
+	if (nt) {
+		if (!touch_bb_write_byte((uint8_t)(addr << 1))) {
+			err = ENXIO;
+		} else {
+			for (unsigned i = 0; i < nt && !err; ++i) {
+				if (!touch_bb_write_byte(tx[i])) {
+					err = ENXIO;
+				}
+			}
+		}
+		if (!stretch || err) {
+			touch_bb_stop();
+		}
+	} else if (nr) {
+		if (!touch_bb_write_byte((uint8_t)((addr << 1) | 1u))) {
+			err = ENXIO;
+		} else {
+			for (unsigned i = 0; i < nr; ++i) {
+				rx[i] = touch_bb_read_byte(i + 1u < nr);
+			}
+		}
+		touch_bb_stop();
+	} else {
+		touch_bb_stop();
+	}
+	return err;
+}
+
+static void
+touch_bb_init(void)
+{
+	uint64_t f;
+
+	__asm__ volatile("mrs %0, cntfrq_el0" : "=r"(f));
+	touch_bb_freq = f ? f : 24000000u;
+	touch_bb_sda(false);
+	touch_bb_scl(false);
+	/* Recover a slave that holds SDA low (for example after a warm reset). */
+	if (!touch_bb_sda_read()) {
+		printf("SWEET TOUCH: I2C bus busy; clocking SCL\n");
+		for (unsigned i = 0; i < 9; ++i) {
+			touch_bb_scl(true);
+			touch_bb_delay();
+			touch_bb_scl(false);
+			touch_bb_delay();
+		}
+		touch_bb_stop();
+	}
+	printf("SWEET TOUCH: bit-bang I2C, counter %llu Hz\n",
+	    (unsigned long long)touch_bb_freq);
+}
