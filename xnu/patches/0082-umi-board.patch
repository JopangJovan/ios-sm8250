diff --git a/pexpert/pexpert/arm64/UMI.h b/pexpert/pexpert/arm64/UMI.h
new file mode 100644
index 0000000..f3e5c77
--- /dev/null
+++ b/pexpert/pexpert/arm64/UMI.h
@@ -0,0 +1,79 @@
+/*
+ * Board config for the Xiaomi Mi 10 ("umi", Qualcomm SM8250 /
+ * Snapdragon 865): Kryo 585 = one Cortex-A77 prime, three Cortex-A77
+ * performance and four Cortex-A55 efficiency cores, ARMv8.2, no PAC.
+ *
+ * UMI uses the generic SWEET bring-up platform (same 16K pages, GICv3
+ * Group 1 and PSCI) and adds the SM8250-specific values that differ from
+ * the Redmi Note 10 Pro (sweet, SM7150). The build defines both
+ * ARM64_BOARD_CONFIG_SWEET and ARM64_BOARD_CONFIG_UMI so the existing
+ * sweet implementation files remain available; code that needs a UMI
+ * value selects it with #if defined(UMI).
+ */
+
+#ifndef _PEXPERT_ARM64_UMI_H
+#define _PEXPERT_ARM64_UMI_H
+
+#include <pexpert/arm64/SWEET.h>
+
+#define UMI                       1
+
+/* Machine-readable board name used in logs and tools. */
+#define UMI_BOARD_NAME            "umi"
+#define UMI_SOC_NAME              "sm8250"
+
+/*
+ * Panel and continuous-splash framebuffer. The Mi 10 panel is 1080x2340;
+ * ABL leaves the continuous splash in the same reserved region as sweet.
+ * XNU still presents the iPhone X logical size (1125x2436) to userland.
+ */
+#define UMI_PANEL_WIDTH           1080
+#define UMI_PANEL_HEIGHT          2340
+#define UMI_FB_PHYS               0x9c000000
+#define UMI_FB_SIZE               0x02300000
+
+/* Internal UFS host (ufshc@1d84000); ABL leaves the link running. */
+#define UMI_UFS_PHYS              0x1d84000
+#define UMI_UFS_SIZE              0x3000
+
+/*
+ * SM8250 uses the standard ARM generic-timer PPIs (GIC_PPI 11 for the
+ * virtual timer), unlike SM7150's Qualcomm numbering.
+ */
+#undef  SWEET_VTIMER_INTID
+#define SWEET_VTIMER_INTID        27
+
+/*
+ * Touch: FocalTech FTS at 0x49 on QUPv3 SE13 (wrapper1 local S5,
+ * 0xa94000), SDA/SCL TLMM 36/37, reset 38, IRQ 39, 3.3 V enable 69.
+ * The 1.8 V rail is PM8150A L1 (left enabled by firmware for now).
+ */
+#define UMI_TOUCH_SE_PHYS         0x00a94000
+#define UMI_TOUCH_GCC_RCG         0x00018600
+#define UMI_TOUCH_GCC_HALT        0x000185fc
+#define UMI_TOUCH_GCC_VOTE        0x00052008
+#define UMI_TOUCH_GCC_MASK        ((0x0fu << 18) | (1u << 27))
+#define UMI_TOUCH_GPIO_PHYS       0x0f000000
+#define UMI_TOUCH_GPIO_SIZE       0x01000000
+#define UMI_TOUCH_SDA_GPIO        36
+#define UMI_TOUCH_SCL_GPIO        37
+#define UMI_TOUCH_RESET_GPIO      38
+#define UMI_TOUCH_IRQ_GPIO        39
+#define UMI_TOUCH_POWER_GPIO      69
+#define UMI_TOUCH_FTS_ADDR        0x49
+#define UMI_TOUCH_MAX_X           1079
+#define UMI_TOUCH_MAX_Y           2339
+
+/*
+ * Keys: PM8150 SID 0 PON (power + volume-down) and PM8150 GPIO6
+ * (volume-up, active low). SPMI PPID = SID << 8 | (0xc0 + gpio - 1).
+ */
+#define UMI_KEYS_PON_PPID         0x0008
+#define UMI_KEYS_GPIO_PPID        0x00c5
+
+/* Descriptive CPU frequencies for the ADT (Hz). */
+#define UMI_CPU_PRIME_HZ          2841600000u
+#define UMI_CPU_GOLD_HZ           2419200000u
+#define UMI_CPU_SILVER_HZ         1804800000u
+
+#endif /* ! _PEXPERT_ARM64_UMI_H */
