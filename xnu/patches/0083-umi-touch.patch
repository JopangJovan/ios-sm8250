  *   Y = (evt[4] << 4) | ((evt[3] & 0xf0) >> 4)
  * Slot ID:
  *   id = (evt[1] >> 4) & 0x0f
+ *
+ * The UMI device tree has no reset-gpio property, so the vendor driver
+ * resets the IC through the FTI system register instead of the reset pad:
+ *   fts_writeU8UX(FTS_CMD_HW_REG_W, BITS_32, ADDR_SYSTEM_RESET, {0x80}, 1)
+ * i.e. FA 20 00 00 24 80, then waits for EVT_ID_CONTROLLER_READY (0x03).
+ * Reset the same way here, and drain before writing: the reset pad pulse
+ * earlier in the probe already posted its own ready event.
  */
+/* FTI system register read: FA <addr:32> then read.  A STOP between the two
+ * messages is fine here, exactly like the FIFO command below. */
+static int
+touch_fts_hw_read(uint32_t reg, uint8_t *buf, unsigned len)
+{
+	uint8_t cmd[5] = {0xfa, (uint8_t)(reg >> 24), (uint8_t)(reg >> 16),
+	    (uint8_t)(reg >> 8), (uint8_t)reg};
+	int err = touch_msg(TOUCH_FTS_ADDR, cmd, sizeof(cmd), NULL, 0, false);
+
+	if (err) {
+		return err;
+	}
+	return touch_msg(TOUCH_FTS_ADDR, NULL, 0, buf, len, false);
+}
+
+/* Bring-up diagnostic: dump the FTI system registers so the values can be
+ * diffed against the same chip driven by the vendor driver in TWRP. */
+static void
+touch_fts_dump_regs(const char *tag)
+{
+	static const struct {
+		uint32_t reg;
+		unsigned len;
+		const char *name;
+	} regs[] = {
+		{0x20000000, 4, "chipid"},
+		{0x20000004, 4, "fwver"},
+		{0x20000024, 1, "sysreset"},
+		{0x20000025, 1, "bootopt"},
+		{0x20000029, 1, "ier"},
+		{0x2000002d, 1, "icr"},
+		{0x20000030, 2, "gpio_in"},
+		{0x20000032, 2, "gpio_dir"},
+		{0x20000034, 2, "gpio_pu"},
+		{0x20000078, 1, "crc"},
+	};
+
+	for (unsigned i = 0; i < sizeof(regs) / sizeof(regs[0]); ++i) {
+		uint8_t b[4] = {0};
+
+		if (touch_fts_hw_read(regs[i].reg, b, regs[i].len)) {
+			printf("SWEET TOUCH: %s reg %s err\n", tag, regs[i].name);
+			continue;
+		}
+		printf("SWEET TOUCH: %s reg %s %#x = %02x %02x %02x %02x\n",
+		    tag, regs[i].name, regs[i].reg, b[0], b[1], b[2], b[3]);
+	}
+}
+
+/* The vendor never writes the interrupt enable register (ADDR_IER); it comes
+ * up from firmware default (0x02 on a chip the vendor driver has probed).
+ * Set it explicitly so a firmware that boots with it clear cannot leave us
+ * polling a FIFO that never receives touch events. */
+static void
+touch_fts_set_ier(uint8_t v)
+{
+	const uint8_t cmd[6] = {0xfa, 0x20, 0x00, 0x00, 0x29, v};
+
+	(void)touch_msg(TOUCH_FTS_ADDR, cmd, sizeof(cmd), NULL, 0, false);
+}
+
+static int
+touch_fts_reset(void)
+{
+	static const uint8_t reset_cmd[] = {0xfa, 0x20, 0x00, 0x00, 0x24, 0x80};
+	uint8_t evt[8];
+	int err;
+
+	/*
+	 * The reset pad pulse earlier in the probe posted its own
+	 * controller-ready event.  Drop stale events first: otherwise the
+	 * wait below matches that old 0x03, reports "ready" after ~6 ms and
+	 * the scan command races the firmware still coming out of reset.
+	 */
+	for (int i = 0; i < 32; ++i) {
+		if (touch_read(TOUCH_FTS_ADDR, 0x86, false, evt, sizeof(evt)) ||
+		    evt[0] == 0 || (evt[7] & 0x1fu) == 0) {
+			break;
+		}
+	}
+
+	err = touch_msg(TOUCH_FTS_ADDR, reset_cmd, sizeof(reset_cmd),
+	    NULL, 0, false);
+
+	if (err) {
+		printf("SWEET TOUCH: FTS software reset write err=%d\n", err);
+		return err;
+	}
+	for (int i = 0; i < 50; ++i) {
+		if (!touch_read(TOUCH_FTS_ADDR, 0x86, false, evt, sizeof(evt)) &&
+		    evt[0] == 0x03) {
+			printf("SWEET TOUCH: FTS controller ready after %d ms\n", i * 2);
+			return 0;
+		}
+		touch_wait(2);
+	}
+	printf("SWEET TOUCH: FTS controller ready timeout\n");
+	return EIO;
+}
