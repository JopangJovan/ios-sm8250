  *   Y = (evt[4] << 4) | ((evt[3] & 0xf0) >> 4)
  * Slot ID:
  *   id = (evt[1] >> 4) & 0x0f
+ *
+ * The vendor kernel device tree does carry fts,reset-gpio = <&tlmm 38 0>
+ * (fts,reset-gpio-enable), so the vendor driver pulses the reset pad; it
+ * additionally resets through the FTI system register during fts_crc_check:
+ *   fts_writeU8UX(FTS_CMD_HW_REG_W, BITS_32, ADDR_SYSTEM_RESET, {0x80}, 1)
+ * i.e. FA 20 00 00 24 80, then waits for EVT_ID_CONTROLLER_READY (0x03).
+ * Reset the same way here, and drain before writing: the reset pad pulse
+ * earlier in the probe already posted its own ready event.
  */
+/* FTI system register read: FA <addr:32> then read, as ONE transaction.  A
+ * STOP between the two messages breaks it: the controller ignores the lone
+ * address write and the following bare read returns FIFO event bytes
+ * instead of the register (seen as every dump value coming back 43 .. on
+ * UMI).  stretch=true on the command write holds the bus for the repeated
+ * START, exactly like the FIFO pointer write below. */
+static int
+touch_fts_hw_read(uint32_t reg, uint8_t *buf, unsigned len)
+{
+	uint8_t cmd[5] = {0xfa, (uint8_t)(reg >> 24), (uint8_t)(reg >> 16),
+	    (uint8_t)(reg >> 8), (uint8_t)reg};
+	int err = touch_msg(TOUCH_FTS_ADDR, cmd, sizeof(cmd), NULL, 0, true);
+
+	if (err) {
+		return err;
+	}
+	return touch_msg(TOUCH_FTS_ADDR, NULL, 0, buf, len, false);
+}
+
+/* Bring-up diagnostic: dump the FTI system registers so the values can be
+ * diffed against the same chip driven by the vendor driver in TWRP. */
+static void
+touch_fts_dump_regs(const char *tag)
+{
+	static const struct {
+		uint32_t reg;
+		unsigned len;
+		const char *name;
+	} regs[] = {
+		{0x20000000, 4, "chipid"},
+		{0x20000004, 4, "fwver"},
+		{0x20000024, 1, "sysreset"},
+		{0x20000025, 1, "bootopt"},
+		{0x20000029, 1, "ier"},
+		{0x2000002d, 1, "icr"},
+		{0x20000030, 2, "gpio_in"},
+		{0x20000032, 2, "gpio_dir"},
+		{0x20000034, 2, "gpio_pu"},
+		{0x20000078, 1, "crc"},
+	};
+
+	for (unsigned i = 0; i < sizeof(regs) / sizeof(regs[0]); ++i) {
+		uint8_t b[4] = {0};
+
+		if (touch_fts_hw_read(regs[i].reg, b, regs[i].len)) {
+			printf("SWEET TOUCH: %s reg %s err\n", tag, regs[i].name);
+			continue;
+		}
+		printf("SWEET TOUCH: %s reg %s %#x = %02x %02x %02x %02x\n",
+		    tag, regs[i].name, regs[i].reg, b[0], b[1], b[2], b[3]);
+	}
+}
+
+/* The vendor never writes the interrupt enable register (ADDR_IER); it comes
+ * up from firmware default (0x02 on a chip the vendor driver has probed).
+ * Set it explicitly so a firmware that boots with it clear cannot leave us
+ * polling a FIFO that never receives touch events. */
+static void
+touch_fts_set_ier(uint8_t v)
+{
+	const uint8_t cmd[6] = {0xfa, 0x20, 0x00, 0x00, 0x29, v};
+
+	(void)touch_msg(TOUCH_FTS_ADDR, cmd, sizeof(cmd), NULL, 0, false);
+}
+
+static int
+touch_fts_reset(void)
+{
+	static const uint8_t reset_cmd[] = {0xfa, 0x20, 0x00, 0x00, 0x24, 0x80};
+	uint8_t evt[8];
+	int err;
+
+	/*
+	 * The reset pad pulse earlier in the probe posted its own
+	 * controller-ready event.  Drop stale events first: otherwise the
+	 * wait below matches that old 0x03, reports "ready" after ~6 ms and
+	 * the scan command races the firmware still coming out of reset.
+	 */
+	for (int i = 0; i < 32; ++i) {
+		if (touch_read(TOUCH_FTS_ADDR, 0x86, false, evt, sizeof(evt)) ||
+		    evt[0] == 0 || (evt[7] & 0x1fu) == 0) {
+			break;
+		}
+	}
+
+	err = touch_msg(TOUCH_FTS_ADDR, reset_cmd, sizeof(reset_cmd),
+	    NULL, 0, false);
+
+	if (err) {
+		printf("SWEET TOUCH: FTS software reset write err=%d\n", err);
+		return err;
+	}
+	for (int i = 0; i < 50; ++i) {
+		if (!touch_read(TOUCH_FTS_ADDR, 0x86, false, evt, sizeof(evt)) &&
+		    evt[0] == 0x03) {
+			printf("SWEET TOUCH: FTS controller ready after %d ms\n", i * 2);
+			return 0;
+		}
+		touch_wait(2);
+	}
+	printf("SWEET TOUCH: FTS controller ready timeout\n");
+	return EIO;
+}
+
+/*
+ * Full power-cycle recovery.  The vendor driver always gets a real power-on
+ * reset because the regulators start disabled at every Android boot; here
+ * AVDD (TLMM 69, regulator-fixed, consumed only by the two touch nodes) is
+ * only ever driven high, so a controller left in an odd state by the
+ * bootloader may never see a POR and a software reset alone may not clear
+ * it.  Cut AVDD, check whether the controller (which runs from vdd/PM8150A
+ * L1 on its own, or not at all) still ACKs while it is down, restore, then
+ * reset and re-arm exactly like the vendor power-on path.  Safe: the
+ * display runs off pm8150_l14, a different rail.
+ */
+static void
+touch_fts_power_cycle(unsigned try_no)
+{
+	static const uint8_t scan_on[3] = {0xa0, 0x00, 0x01};
+	uint8_t b[4] = {0};
+	int err;
+
+	touch_gpio(TOUCH_GPIO_POWER, 0, 0, 0, true, false); /* AVDD off */
+	touch_wait(100);
+	err = touch_fts_hw_read(0x20000000, b, 4); /* chip alive on vdd alone? */
+	printf("SWEET TOUCH: por%u: chipid %02x %02x %02x %02x err=%d while avdd off\n",
+	    try_no, b[0], b[1], b[2], b[3], err);
+	touch_gpio(TOUCH_GPIO_POWER, 0, 0, 0, true, true); /* AVDD on */
+	touch_wait(15); /* vendor fts_enable_reg spacing after vdd */
+	(void)touch_fts_reset();
+	(void)touch_msg(TOUCH_FTS_ADDR, scan_on, sizeof(scan_on), NULL, 0, false);
+	touch_wait(100);
+	touch_fts_set_ier(0x02);
+	printf("SWEET TOUCH: por%u: avdd cycled, reset + sense on + ier done\n", try_no);
+	touch_fts_dump_regs("por");
+}
