 			}
 		} else if (id_code == 0x33) {
 			unsigned id = (evt[1] >> 4) & 0x0fu;
 			if (id < TOUCH_MAX) {
 				mask &= ~(1u << id);
-				changed = true;
+				changed = st.evt_seen = true;
 			}
 		}
 		if ((evt[7] & 0x1fu) == 0) {
@@ -1010,6 +1056,7 @@ touch_thread(void *arg, wait_result_t result)
 	    ge, gid[0], gid[1], gid[2], gid[3], gid[8], gid[9], gid[10], gid[11], st.irq_status);
 	(void)touch_probe_info(0x8240, legacy);
 #if defined(UMI)
+	(void)touch_fts_reset();
 	uint8_t fevt[8] = {0};
 	for (int i = 0; i < 16; ++i) {
 		if (touch_read(TOUCH_FTS_ADDR, 0x86, false, fevt, sizeof(fevt)) || fevt[0] == 0) {
@@ -1019,12 +1066,17 @@ touch_thread(void *arg, wait_result_t result)
 			break;
 		}
 	}
-	const uint8_t scan_off[3] = {0xa0, 0x00, 0x00};
-	(void)touch_msg(TOUCH_FTS_ADDR, scan_off, sizeof(scan_off), NULL, 0, false);
-	touch_wait(50);
+	/*
+	 * Vendor Screen ON path: sense on with calibration (0xa0 00 01)
+	 * straight after the reset.  Do not insert a sense-off first: a bare
+	 * 0xa0 00 00 -> 0xa0 00 01 pair leaves the scan engine off on this
+	 * panel (verified raw against the controller in TWRP; 0xa0 00 20,
+	 * sense on without cal, is what restores it and is the fallback in
+	 * the poll loop below).
+	 */
 	const uint8_t scan_on[3] = {0xa0, 0x00, 0x01};
 	(void)touch_msg(TOUCH_FTS_ADDR, scan_on, sizeof(scan_on), NULL, 0, false);
-	touch_wait(20);
+	touch_wait(100);
 	int fe = touch_read(TOUCH_FTS_ADDR, 0x86, false, fevt, sizeof(fevt));
 	printf("SWEET TOUCH: probe %#x err=%d evt=%02x %02x %02x %02x irq=%#x\n",
 	    TOUCH_FTS_ADDR, fe, fevt[0], fevt[1], fevt[2], fevt[3], st.irq_status);
@@ -1057,9 +1109,10 @@ touch_thread(void *arg, wait_result_t result)
 	    TOUCH_MAX_X + 1, TOUCH_MAX_Y + 1, st.irq_hint);
 	unsigned errors = 0, ticks = 0;
 	while (!st.dead) {
+		++ticks;
 		/* Optional IRQ hint still reads every 100ms, and always while down. */
 		if (!st.irq_hint || st.active || !(touch_rd(st.gpio, TOUCH_GPIO_IO(TOUCH_GPIO_IRQ)) & 1u) ||
-		    (++ticks % 10u) == 0) {
+		    (ticks % 10u) == 0) {
 			int err = st.kind == TOUCH_GOODIX ? touch_goodix() : touch_focaltech();
 			if (err) {
 				if ((errors++ % 100u) == 0) {
@@ -1072,6 +1125,30 @@ touch_thread(void *arg, wait_result_t result)
 				errors = 0;
 			}
 		}
+#if defined(UMI)
+		/* Temporary bring-up diagnostic: shows whether the panel raises IRQ. */
+		if ((ticks % 500u) == 0) {
+			printf("SWEET TOUCH: poll tick=%u irq_pin=%d active=%#x\n",
+			    ticks, (touch_rd(st.gpio, TOUCH_GPIO_IO(TOUCH_GPIO_IRQ)) & 1u),
+			    st.active);
+		}
+		/*
+		 * Bring-up safety net: the scan engine can fail to come up
+		 * after reset (a bare sense-off -> sense-on-with-cal pair
+		 * leaves it off, verified raw in TWRP).  If no touch event
+		 * has ever arrived, re-arm with sense on without cal, which
+		 * is what restored scanning in that experiment.
+		 */
+		if (!st.evt_seen && (ticks % 300u) == 0 && st.fallback < 3u) {
+			static const uint8_t scan_nocal[3] = {0xa0, 0x00, 0x20};
+
+			++st.fallback;
+			(void)touch_msg(TOUCH_FTS_ADDR, scan_nocal, sizeof(scan_nocal),
+			    NULL, 0, false);
+			printf("SWEET TOUCH: no touch events yet; sense on without cal (try %u)\n",
+			    st.fallback);
+		}
+#endif
 		touch_wait(10);
 	}
 	touch_report(0, st.x, st.y);
