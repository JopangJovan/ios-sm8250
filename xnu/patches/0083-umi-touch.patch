+#define TOUCH_FTS_SYSINFO_LEN 208 /* SYS_INFO_SIZE */
+
+/* Framebuffer read: A6 <addr:16> then read as one transaction (repeated
+ * START, like the register read above).  I2C has no dummy byte
+ * (DUMMY_FRAMEBUFFER = 0 for I2C_INTERFACE). */
+static int
+touch_fts_frame_read(uint16_t addr, uint8_t *buf, unsigned len)
+{
+	uint8_t cmd[3] = {0xa6, (uint8_t)(addr >> 8), (uint8_t)addr};
+	int err = touch_msg(TOUCH_FTS_ADDR, cmd, sizeof(cmd), NULL, 0, true);
+
+	if (err) {
+		return err;
+	}
+	return touch_msg(TOUCH_FTS_ADDR, NULL, 0, buf, len, false);
+}
+
+/*
+ * The vendor probe step we were missing: fts_fw_update() reads the 208-byte
+ * system info from the framebuffer and compares the AFE versions - CFG
+ * (byte 28), CX (29), PanelMem (30).  With PRE_SAVED_METHOD a CFG != CX
+ * selects SPECIAL_FULL_PANEL_INIT and a CFG != PANEL selects
+ * SPECIAL_PANEL_INIT; production_test_initialization() then resets and
+ * writes the system command (A4 00 03 / A4 00 02), and readSysInfo(1)
+ * refreshes the info (A4 06 01 + framebuffer re-read).  Without this the
+ * controller still resets, echoes and calibrates (mutual-negative force-cal
+ * events) but the analog front end never gets initialized for this panel,
+ * so no touch points are ever generated - matching every iOS log so far.
+ */
+static void
+touch_fts_panel_init(void)
+{
+	uint8_t si[TOUCH_FTS_SYSINFO_LEN];
+	static const uint8_t full_init[] = {0xa4, 0x00, 0x03};
+	static const uint8_t panel_init[] = {0xa4, 0x00, 0x02};
+	static const uint8_t load_info[] = {0xa4, 0x06, 0x01};
+	const uint8_t *send = NULL;
+	const char *why = NULL;
+	bool have_info = false;
+
+	if (touch_fts_frame_read(0, si, sizeof(si))) {
+		printf("SWEET TOUCH: sysinfo read err; blind panel init\n");
+		send = panel_init;
+		why = "read err";
+	} else if (si[0] != 0xa5) {
+		printf("SWEET TOUCH: sysinfo hdr=%02x want a5; blind panel init\n",
+		    si[0]);
+		send = panel_init;
+		why = "bad hdr";
+	} else {
+		have_info = true;
+		printf("SWEET TOUCH: sysinfo fw=%04x svn=%04x cfgver=%04x afe cfg/cx/panel=%02x/%02x/%02x\n",
+		    (uint32_t)(si[16] | (si[17] << 8)),
+		    (uint32_t)(si[18] | (si[19] << 8)),
+		    (uint32_t)(si[20] | (si[21] << 8)),
+		    si[28], si[29], si[30]);
+		if (si[28] != si[29]) {
+			send = full_init;
+			why = "cfg!=cx";
+		} else if (si[28] != si[30]) {
+			send = panel_init;
+			why = "cfg!=panel";
+		} else {
+			printf("SWEET TOUCH: afe versions match; vendor skips init\n");
+			return;
+		}
+	}
+	/* production_test_initialization() resets before the command. */
+	(void)touch_fts_reset();
+	(void)touch_msg(TOUCH_FTS_ADDR, send, 3, NULL, 0, false);
+	printf("SWEET TOUCH: sent %s panel init (%s)\n",
+	    send == full_init ? "full" : "panel", why);
+	touch_wait(100); /* GENERAL_TIMEOUT */
+	(void)touch_msg(TOUCH_FTS_ADDR, load_info, sizeof(load_info),
+	    NULL, 0, false);
+	touch_wait(50);
+	if (have_info && !touch_fts_frame_read(0, si, sizeof(si)) &&
+	    si[0] == 0xa5) {
+		printf("SWEET TOUCH: sysinfo after init afe cfg/cx/panel=%02x/%02x/%02x\n",
+		    si[28], si[29], si[30]);
+	}
+}
