+/*
+ * Full power-cycle recovery.  The vendor driver always gets a real power-on
+ * reset because the regulators start disabled at every Android boot; here
+ * AVDD (TLMM 69, regulator-fixed, consumed only by the two touch nodes) is
+ * only ever driven high, so a controller left in an odd state by the
+ * bootloader may never see a POR and a software reset alone may not clear
+ * it.  Cut AVDD, check whether the controller (which runs from vdd/PM8150A
+ * L1 on its own, or not at all) still ACKs while it is down, restore, then
+ * reset and re-arm exactly like the vendor power-on path.  Safe: the
+ * display runs off pm8150_l14, a different rail.
  */
+static void
+touch_fts_power_cycle(unsigned try_no)
+{
+	static const uint8_t scan_on[3] = {0xa0, 0x00, 0x01};
+	uint8_t b[4] = {0};
+	int err;
+
+	touch_gpio(TOUCH_GPIO_POWER, 0, 0, 0, true, false); /* AVDD off */
+	touch_wait(100);
+	err = touch_fts_hw_read(0x20000000, b, 4); /* chip alive on vdd alone? */
+	printf("SWEET TOUCH: por%u: chipid %02x %02x %02x %02x err=%d while avdd off\n",
+	    try_no, b[0], b[1], b[2], b[3], err);
+	touch_gpio(TOUCH_GPIO_POWER, 0, 0, 0, true, true); /* AVDD on */
+	touch_wait(15); /* vendor fts_enable_reg spacing after vdd */
+	(void)touch_fts_reset();
+	touch_fts_panel_init(); /* AFE versions may change after a fresh reset */
+	(void)touch_msg(TOUCH_FTS_ADDR, scan_on, sizeof(scan_on), NULL, 0, false);
+	touch_wait(100);
+	touch_fts_set_ier(0x02);
+	printf("SWEET TOUCH: por%u: avdd cycled, reset + sense on + ier done\n", try_no);
+	touch_fts_dump_regs("por");
+}
