diff --git a/bsd/dev/sweet_touch.c b/bsd/dev/sweet_touch.c
index 2d74a77..8dc5b4d 100644
--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -700,7 +700,40 @@ touch_goodix(void)
  *   Y = (evt[4] << 4) | ((evt[3] & 0xf0) >> 4)
  * Slot ID:
  *   id = (evt[1] >> 4) & 0x0f
+ *
+ * The UMI device tree has no reset-gpio property, so the vendor driver
+ * resets the IC through the FTI system register instead of the reset pad:
+ *   fts_writeU8UX(FTS_CMD_HW_REG_W, BITS_32, ADDR_SYSTEM_RESET, {0x80}, 1)
+ * i.e. FA 20 00 00 24 80, then waits for EVT_ID_CONTROLLER_READY (0x03).
+ * A reset-pad pulse alone leaves the application firmware running without
+ * its panel configuration: the FIFO answers status/echo events, but the
+ * panel never scans.
  */
+static int
+touch_fts_reset(void)
+{
+	static const uint8_t reset_cmd[] = {0xfa, 0x20, 0x00, 0x00, 0x24, 0x80};
+	int err = touch_msg(TOUCH_FTS_ADDR, reset_cmd, sizeof(reset_cmd),
+	    NULL, 0, false);
+
+	if (err) {
+		printf("SWEET TOUCH: FTS software reset write err=%d\n", err);
+		return err;
+	}
+	for (int i = 0; i < 50; ++i) {
+		uint8_t evt[8];
+
+		if (!touch_read(TOUCH_FTS_ADDR, 0x86, false, evt, sizeof(evt)) &&
+		    evt[0] == 0x03) {
+			printf("SWEET TOUCH: FTS controller ready after %d ms\n", i * 2);
+			return 0;
+		}
+		touch_wait(2);
+	}
+	printf("SWEET TOUCH: FTS controller ready timeout\n");
+	return EIO;
+}
+
 static int
 touch_st_fts(void)
 {
@@ -1010,6 +1043,7 @@ touch_thread(void *arg, wait_result_t result)
 	    ge, gid[0], gid[1], gid[2], gid[3], gid[8], gid[9], gid[10], gid[11], st.irq_status);
 	(void)touch_probe_info(0x8240, legacy);
 #if defined(UMI)
+	(void)touch_fts_reset();
 	uint8_t fevt[8] = {0};
 	for (int i = 0; i < 16; ++i) {
 		if (touch_read(TOUCH_FTS_ADDR, 0x86, false, fevt, sizeof(fevt)) || fevt[0] == 0) {
@@ -1057,9 +1091,10 @@ touch_thread(void *arg, wait_result_t result)
 	    TOUCH_MAX_X + 1, TOUCH_MAX_Y + 1, st.irq_hint);
 	unsigned errors = 0, ticks = 0;
 	while (!st.dead) {
+		++ticks;
 		/* Optional IRQ hint still reads every 100ms, and always while down. */
 		if (!st.irq_hint || st.active || !(touch_rd(st.gpio, TOUCH_GPIO_IO(TOUCH_GPIO_IRQ)) & 1u) ||
-		    (++ticks % 10u) == 0) {
+		    (ticks % 10u) == 0) {
 			int err = st.kind == TOUCH_GOODIX ? touch_goodix() : touch_focaltech();
 			if (err) {
 				if ((errors++ % 100u) == 0) {
@@ -1072,6 +1107,14 @@ touch_thread(void *arg, wait_result_t result)
 				errors = 0;
 			}
 		}
+#if defined(UMI)
+		/* Temporary bring-up diagnostic: shows whether the panel raises IRQ. */
+		if ((ticks % 500u) == 0) {
+			printf("SWEET TOUCH: poll tick=%u irq_pin=%d active=%#x\n",
+			    ticks, (touch_rd(st.gpio, TOUCH_GPIO_IO(TOUCH_GPIO_IRQ)) & 1u),
+			    st.active);
+		}
+#endif
 		touch_wait(10);
 	}
 	touch_report(0, st.x, st.y);
